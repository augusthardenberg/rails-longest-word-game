<h1>New Game</h1>

<div class="letters">
  <% @letters.each do |letter| %>
    <span class="letter"><%= letter %></span>
  <% end %>
</div>

<form action="score" method="post" data-turbo="false" class="form">
  <label>Your guess:</label><br>
  <input type="text" name="guess" placeholder="Type your word here..."><br>
  <input type="submit" value="Submit your word"><br>
  <input id="token" name="token" type="hidden" value=<%= @letters.join %> />
  <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
  <%= hidden_field_tag :started_at, @started_at %>
</form>
